{
  "name": "ai-turtle-soup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/src/index.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android",
    "eval:validate": "node --env-file-if-exists=.env --import tsx eval/run.ts",
    "eval:live": "node --env-file-if-exists=.env --import tsx eval/run.ts --live"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "^8.1.0",
    "vitest": "^5.0.0",
    "@types/express": "^5.0.0"
  }
}
