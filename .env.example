# Loaded by backend and evaluation commands only. Keep AI credentials out of client bundles.
# Current product profile: Alibaba Cloud Bailian Beijing Qwen3.8-Flash.
# Replace the placeholder in your local .env; never put a real workspace URL or key in this file.
AI_API_KEY=
AI_BASE_URL=https://ws-your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.8-flash
AI_THINKING=disabled
HOST=127.0.0.1
PORT=8787
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost,https://localhost

# Optional alternative profile: GLM (requires workspace product activation)
# AI_MODEL=ZHIPU/GLM-5.3-Flash
# AI_THINKING=enabled

# Optional alternative profile: DeepSeek
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash
# AI_THINKING=disabled
